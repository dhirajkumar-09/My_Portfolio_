# ==============================================================================
# DHIRAJ KUMAR PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Note: In Vite, variables exposed to the browser must be prefixed with 'VITE_'.

# --- Firebase Web App Configuration ---
# Obtain these from: Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere12345
VITE_FIREBASE_AUTH_DOMAIN=dhirajkumar-portfolio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dhirajkumar-portfolio
VITE_FIREBASE_STORAGE_BUCKET=dhirajkumar-portfolio.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# --- Portfolio Admin Credentials ---
# The primary admin email authorized to access /admin and modify data
VITE_ADMIN_EMAIL=dhirajku00021@gmail.com
# (Optional) The specific Firebase Auth UID for Dhiraj Kumar:
VITE_ADMIN_UID=

# --- EmailJS Integration (Contact Form to Inbox) ---
# Obtain from: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=service_portfolio
VITE_EMAILJS_TEMPLATE_ID=template_contact
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
